# Copiez ce fichier en `.env` et adaptez.

# Chemin du fichier SQLite local (créé automatiquement au démarrage).
DATABASE_URL="./dev.db"

# Port HTTP du serveur.
PORT=3000

# Secret utilisé pour signer le cookie de session (chaîne aléatoire longue,
# jamais commitée en clair dans un vrai déploiement).
SESSION_SECRET="change-me-in-production"

# --- Stripe : MODE TEST UNIQUEMENT ---
# Récupérez ces valeurs dans le Dashboard Stripe > Developers > API keys, en
# mode "Test" (elles commencent par sk_test_ / whsec_...). Ne mettez jamais
# de clé "live" (sk_live_...) dans ce projet : aucune vérification de
# conformité (PCI-DSS, etc.) n'a été faite ici, ce n'est pas un système prêt
# pour de vrais paiements.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
