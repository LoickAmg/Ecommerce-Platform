{
  "name": "ecommerce-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Plateforme e-commerce (catalogue, panier, comptes, commandes, paiement Stripe en mode test) — Node/Express/SQLite (node:sqlite intégré, aucun binaire externe à télécharger).",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "lint": "eslint .",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "express": "^4.21.0",
    "stripe": "^16.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.10.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.5.0",
    "vitest": "^2.1.1"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
